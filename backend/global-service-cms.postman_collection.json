			"item": [
				{
					"name": "Iniciar Sesión (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.ok && response.data && response.data.token) {",
									"    pm.collectionVariables.set(\"token\", response.data.token);",
									"    console.log(\"Token JWT guardado automáticamente en la variable de la colección: {{token}}\");",
									"}"
								],
								"type": "javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@globalservice.bo\",\n  \"password\": \"admin123.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Autentica al usuario administrador o editor. Si las credenciales son válidas y el usuario está activo, devuelve un token JWT que se guarda de manera automática en la variable {{token}} de la colección para autorizar el resto de llamadas."
					},
					"response": []
				},
				{
					"name": "Obtener mi Perfil (/me)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/auth/me",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						},
						"description": "Obtiene la información del usuario autenticado a través del token JWT."
					},
					"response": []
				}
			]
